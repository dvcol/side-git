# GitHub OAuth App credentials.
#
# Copy this file to env/.env.local and fill in the values from your OAuth App
# (https://github.com/settings/developers). In CI these come from repo secrets.
#
# - client id / secret are read by the web (launchWebAuthFlow) flow.
# - the device flow only needs the client id.

# OAuth App client id (https://github.com/settings/developers)
VITE_GITHUB_CLIENT_ID=your-client-id

# OAuth App client secret (web flow only). Keep out of git.
VITE_GITHUB_CLIENT_SECRET=your-client-secret

# Space-separated OAuth scopes. `repo` is needed to see private PRs.
VITE_GITHUB_SCOPE=read:user repo read:discussion write:discussion actions:read actions:write workflow
