{
  "name": "@dvcol/side-git",
  "type": "module",
  "version": "1.8.0",
  "title": "Side Git",
  "packageManager": "pnpm@11.1.0",
  "description": "A browser extension side panel for GitHub",
  "author": "dvcol",
  "license": "MIT",
  "homepage": "https://github.com/dvcol/side-git",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvcol/side-git.git"
  },
  "bugs": "https://github.com/dvcol/side-git/issues",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "files": [
    "*.md",
    "LICENSE",
    "build/lib"
  ],
  "engines": {
    "node": ">=20",
    "pnpm": ">= 7"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "clear": "rimraf dist",
    "dist": "pnpm run clear && esno scripts/prepare.ts",
    "type:watch": "tsc --noEmit --watch",
    "vite:serve": "vite",
    "vite:build": "vite build",
    "vite:watch": "vite build --watch",
    "vite:preview": "vite preview",
    "svelte:check": "svelte-check --tsconfig ./tsconfig.app.json --compiler-warnings \"css-unused-selector:ignore\"",
    "svelte:watch": "pnpm run svelte:check --watch",
    "dev": "cross-env NODE_ENV=development run-p dist vite:serve",
    "dev:web": "VITE_SOURCEMAP=true VITE_WEB=true VITE_BASE=/side-git/ run-s dev",
    "build": "cross-env NODE_ENV=production run-s dist svelte:check 'vite:build {@}' --",
    "build:web": "VITE_WEB=true VITE_BASE=/side-git/ run-s build",
    "serve:web": "VITE_SOURCEMAP=true VITE_WEB=true VITE_BASE=/side-git/ run-s build vite:preview",
    "build:all": "run-p build build:web",
    "analyse": "VITE_DEVTOOLS=true pnpm run build",
    "test:unit": "vitest run --coverage --mode testing",
    "test:watch": "vitest --mode testing",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "style": "stylelint '**/*.{svelte,css,scss,less,html}' --go '{\"gitignore\":true}'",
    "style:fix": "pnpm run style --fix",
    "release": "commit-and-tag-version",
    "release:changelog": "extract-changelog-release > RELEASE.md"
  },
  "dependencies": {
    "@dvcol/common-utils": "^1.34.0",
    "@dvcol/neo-svelte": "^1.2.0",
    "@dvcol/svelte-simple-router": "^2.7.2",
    "@dvcol/svelte-utils": "^3.2.1",
    "@dvcol/web-extension-utils": "^3.5.3",
    "svelte": "^5.55.10"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@dvcol/eslint-config": "^1.8.6",
    "@dvcol/stylelint-plugin-presets": "^2.1.3",
    "@prettier/plugin-xml": "^3.4.2",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.1.42",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/devtools": "^0.3.1",
    "@vitest/coverage-v8": "^4.1.7",
    "c8": "^11.0.0",
    "chokidar": "^5.0.0",
    "commit-and-tag-version": "^12.7.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-svelte": "^3.18.0",
    "esno": "^4.8.0",
    "extract-changelog-release": "^1.0.2",
    "fs-extra": "^11.3.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "magic-string": "^0.30.21",
    "npm-run-all2": "^9.0.1",
    "postcss": "^8.5.15",
    "postcss-syntax": "^0.36.2",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.1",
    "rimraf": "^6.1.3",
    "sass": "^1.100.0",
    "stylelint": "^17.12.0",
    "svelte-check": "^4.4.8",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-checker": "^0.14.1",
    "vite-plugin-dts": "^5.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7",
    "webextension-polyfill": "^0.12.0"
  }
}
